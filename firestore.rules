rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && myEmail() == 'ADMIN_EMAIL'; }
    function isMember() { return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/allowed/$(myEmail()))); }

    // Einladungsliste: nur der Admin verwaltet sie, jede Person darf ihren eigenen Eintrag lesen
    match /allowed/{mail} {
      allow read: if isAdmin() || (signedIn() && mail == myEmail());
      allow write: if isAdmin();
    }
    // Teamprofile: alle Mitglieder lesen, jede Person schreibt nur ihr eigenes
    match /team/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }
    // Kunden, Jobs, Notizen, Planungen: alle freigeschalteten Mitglieder
    match /clients/{id}  { allow read, write: if isMember(); }
    match /projects/{id} { allow read, write: if isMember(); }
    match /notes/{id}    { allow read, write: if isMember(); }
    match /slots/{id}    { allow read, write: if isMember(); }
    // E-Mail-Verläufe: alle Mitglieder lesen alle Verläufe; schreiben nur die Besitzerin/der Besitzer (owner) bzw. der Admin für den stündlichen Import
    match /threads/{id} {
      allow read: if isMember();
      allow create: if isMember() && (request.resource.data.owner == request.auth.uid || isAdmin());
      allow update: if isMember() && (resource.data.get('owner', '') == request.auth.uid || isAdmin()) && (request.resource.data.get('owner', '') == resource.data.get('owner', '') || isAdmin());
      allow delete: if isMember() && (resource.data.get('owner', '') == request.auth.uid || isAdmin());
    }
  }
}
